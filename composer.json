{
  "name": "canarts/circular-arts-network",
  "description": "Circular Arts Network WordPress plugin",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^6.8",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "test": "composer test:unit",
    "test:unit": "vendor/bin/phpunit -c phpunit.xml.dist",
    "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit -c phpunit.xml.dist --coverage-text --coverage-clover=coverage/clover.xml --coverage-html=coverage/html",
    "test:integration": "WP_TESTS_DIR=vendor/wp-phpunit/wp-phpunit WP_PHPUNIT__TESTS_CONFIG=tests/integration/wp-tests-config.php vendor/bin/phpunit -c phpunit.integration.xml.dist"
  }
}
